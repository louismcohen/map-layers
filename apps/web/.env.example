# Copy to apps/web/.env — never commit real values.
# Vite inlines VITE_* at build time (static SPA). Changing a host env var requires a rebuild.

# Map tiles + Isochrone API. Restrict the token by URL (localhost:5173 + production origin).
VITE_MAPBOX_ACCESS_TOKEN=

# Places Text Search (New). Enable Places API (New). Restrict by HTTP referrer
# (http://localhost:5173/* , http://127.0.0.1:5173/* , and https://your-domain/*).
VITE_GOOGLE_MAPS_API_KEY=

# Auth + PostgREST. Local: `supabase start` then copy API URL + Publishable key from `supabase status`.
# Hosted: Project Settings → API. Value is sb_publishable_… (public by design). Never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
